// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password_hash String?
  nickname String @db.VarChar(10)
  is_onboarded Boolean @default(false)
  onboarded_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  desired_fields UserDesiredField[]
  onboarding_answers OnboardingAnswer[]
  recommendation Recommendation?
  chat_sessions ChatSession[]
  roadmaps Roadmap[]

  @@map("user")
}

model Field {
  id Int @id @default(autoincrement())
  name String @db.VarChar(30)

  desired_by UserDesiredField[]
  onboarding_options OnboardingOption[]
  certificates CertificateField[]

  @@map("field")
}

model UserDesiredField {
  id Int @id @default(autoincrement())
  user_id Int
  field_id Int

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  field Field @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([user_id, field_id])
  @@map("user_desired_field")
}

model OnboardingQuestion {
  id Int @id @default(autoincrement())
  question_key String @unique @db.VarChar(50)
  title String
  min_select Int @default(1)
  max_select Int?
  order_no Int
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  options OnboardingOption[]
  answers OnboardingAnswer[]

  @@map("onboarding_question")
}

model OnboardingOption {
  id Int @id @default(autoincrement())
  question_id Int
  field_id Int?
  option_key String @db.VarChar(50)
  value String @db.VarChar(50)
  label String
  order_no Int
  is_active Boolean @default(true)

  question OnboardingQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  field Field? @relation(fields: [field_id], references: [id])
  answers OnboardingAnswer[]

  @@unique([question_id, option_key])
  @@unique([question_id, value])
  @@map("onboarding_option")
}

model OnboardingAnswer {
  id Int @id @default(autoincrement())
  user_id Int
  question_id Int
  option_id Int
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question OnboardingQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  option OnboardingOption @relation(fields: [option_id], references: [id], onDelete: Cascade)

  @@unique([user_id, option_id])
  @@map("onboarding_answer")
}

model Certification {
  jm_cd String @id @db.VarChar(10)
  jm_nm String
  qual_gb_cd String
  series_nm String?
  // ERD 는 decimal 이지만 Prisma Decimal 은 JSON 에 문자열로 직렬화된다. 명세의 number 를 맞추려면 Float 다
  doc_pass_rate Float?
  prac_pass_rate Float?
  doc_fee Int?
  prac_fee Int?

  qual_detail QualDetail?
  exam_schedules ExamSchedule[]
  fields CertificateField[]
  recommendation_items RecommendationItem[]
  chat_sessions ChatSession[]

  @@map("certification")
}

// 국가기술자격만 행이 존재
// 공공데이터 결측이 흔해 jm_cd 외에는 전부 nullable
model QualDetail {
  jm_cd String @id @db.VarChar(10)
  mdoblig_fld_nm String? @db.VarChar(100)
  career String? @db.Text
  job String? @db.Text
  summary String? @db.Text
  trend String? @db.Text
  hist String? @db.Text

  certification Certification @relation(fields: [jm_cd], references: [jm_cd], onDelete: Cascade)

  @@map("qual_detail")
}

model ExamSchedule {
  jm_cd String @db.VarChar(10)
  impl_yy Int @db.SmallInt
  impl_seq String @db.VarChar(10)

  // doc_reg_start_dt 파생 STORED 생성 컬럼(NULL 은 1000-01-01). Prisma 가 생성 컬럼을 모르므로
  reg_key DateTime @db.Date
  description String? @db.VarChar(255)
  doc_reg_start_dt DateTime? @db.Date
  doc_reg_end_dt DateTime? @db.Date
  doc_exam_start_dt DateTime? @db.Date
  doc_exam_end_dt DateTime? @db.Date
  doc_pass_dt DateTime? @db.Date
  prac_reg_start_dt DateTime? @db.Date
  prac_reg_end_dt DateTime? @db.Date
  prac_exam_start_dt DateTime? @db.Date
  prac_exam_end_dt DateTime? @db.Date
  prac_pass_dt DateTime? @db.Date

  certification Certification @relation(fields: [jm_cd], references: [jm_cd], onDelete: Cascade)

  @@id([jm_cd, impl_yy, impl_seq, reg_key])
  @@map("exam_schedule")
}

model CertificateField {
  id Int @id @default(autoincrement())
  jm_cd String @db.VarChar(10)
  field_id Int

  certification Certification @relation(fields: [jm_cd], references: [jm_cd], onDelete: Cascade)
  field Field @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([jm_cd, field_id])
  @@map("certificate_field")
}

model Recommendation {
  id Int @id @default(autoincrement())
  user_id Int @unique
  generated_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items RecommendationItem[]

  @@map("recommendation")
}

model RecommendationItem {
  id Int @id @default(autoincrement())
  recommendation_id Int
  jm_cd String @db.VarChar(10)
  rank_no Int
  reason String @db.Text

  recommendation Recommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [jm_cd], references: [jm_cd], onDelete: Cascade)

  @@unique([recommendation_id, rank_no])
  @@map("recommendation_item")
}

enum ChatSender {
  USER
  AI
}

model ChatSession {
  id Int @id @default(autoincrement())
  user_id Int
  jm_cd String? @db.VarChar(10)
  title String @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  certification Certification? @relation(fields: [jm_cd], references: [jm_cd], onDelete: SetNull) // 종목이 삭제돼도 대화는 남김
  messages ChatMessage[]
  roadmaps Roadmap[]

  @@map("chat_session")
}

model ChatMessage {
  id Int @id @default(autoincrement())
  session_id Int
  sender ChatSender
  content String @db.Text
  created_at DateTime @default(now())

  session ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("chat_message")
}

model Roadmap {
  id Int @id @default(autoincrement())
  session_id Int
  user_id Int
  title String @db.VarChar(255)
  created_at DateTime @default(now())

  session ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  steps RoadmapStep[]

  @@map("roadmap")
}

model RoadmapStep {
  id Int @id @default(autoincrement())
  roadmap_id Int
  title String @db.VarChar(255)
  description String @db.Text
  order_no Int
  target_date DateTime? @db.Date

  roadmap Roadmap @relation(fields: [roadmap_id], references: [id], onDelete: Cascade)

  @@unique([roadmap_id, order_no])
  @@map("roadmap_step")
}
